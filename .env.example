# ==============================================================================
# RavanNama (روان‌نما) — Local Development Environment Defaults
# ==============================================================================
# Non-secret local development placeholders ONLY.
# Copy to `.env` for local Docker Compose use.
# NEVER commit real production secrets, tokens, or credentials.
# ==============================================================================

# PostgreSQL 16 (Local Dev)
POSTGRES_USER=ravannama
POSTGRES_PASSWORD=ravannama_local_dev_pw
POSTGRES_DB=ravannama
POSTGRES_PORT=5432
DATABASE_URL=postgres://ravannama:ravannama_local_dev_pw@postgres:5432/ravannama?sslmode=disable

# MinIO S3-Compatible Storage (Local Dev)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:8088
S3_REGION=ir-thr-at1
S3_PUBLIC_BUCKET=ravannama-public
S3_PRIVATE_BUCKET=ravannama-private

# Platform & Auth (Local Dev Placeholders)
PLATFORM_DOMAIN=ravannama.ir
OTP_PEPPER=local-dev-otp-pepper-change-in-prod-32b
COOKIE_SECURE=false
AUTO_MIGRATE=true
SEED_PILOT_DATA=true
DEV_OTP_SINK_FILE=/tmp/ravanama-dev-otp.json

# Service Ports & Reverse Proxy
API_PORT=8080
WEB_PORT=3000
CADDY_HTTP_PORT=8088
CADDY_ASK_URL=http://api:8080/internal/tls/allow
